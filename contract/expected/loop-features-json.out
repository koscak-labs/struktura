--- file lab-300-ub128.sh
#!/usr/bin/env bash
# LAB-META: est_min=10 value=2 out=logs/lab-300-ub128.out pred=lab-pred/lab-300-ub128.tsv
# struktura loop lab-300-ub128: ub 128 (arm A) vs incumbent 256 (arm B) on d100000 (prefill t/s of a 2048-token chunk at 100K depth), 2 runs per arm
# why: never measured on d100000; brain: yield 0.40
set -uo pipefail
source ~/lab-lib.sh
OUT=~/logs/lab-300-ub128.out; : > "$OUT"
med(){ sort -n | awk '{a[NR]=$1} END{if(NR==0){print "VOID"; exit} if(NR%2) print a[(NR+1)/2]; else print (a[NR/2]+a[NR/2+1])/2}'; }
D=$(stage llama.cpp-alien2)
M=/home/phil/models/Qwen3.8-27B-Uncensored-IQ4_XS.gguf
for v in 256 128; do
  for r in $(seq 1 2); do
    x=$(LD_LIBRARY_PATH=$D timeout --foreground 900 $D/llama-bench -m $M -ngl 99 -fa 1 -ctk q4_0 -ctv q4_0 -b 2048 -ub $v -p 2048 -n 0 -d 0,32768,100000 -r 1 -o csv 2>/dev/null \
        | awk -F, 'NR==1{for(i=1;i<=NF;i++){gsub(/"/,"",$i); h[$i]=i}} NR>1{gsub(/"/,""); printf "d%s=%d ", $h["n_depth"], $h["avg_ts"]}')
    printf 'rep\tub%s\t%s\n' "$v" "${x:-FAIL}" | tee -a "$OUT"
  done
  m=$(grep -P "^rep\tub$v\t" "$OUT" | grep -oP 'd100000=\K[0-9.]+' | med)
  printf 'arm\tub%s\tmedian d100000=%s\n' "$v" "$m" | tee -a "$OUT"
done
echo "### lab-300-ub128-DONE $(date +%T)" | tee -a "$OUT"
--- file lab-300-ub128.tsv
# struktura loop lab-300-ub128: predicted 3.00% (prior 3.0% x calibration min(1, 1.09)), threshold 1.73% = predicted - one 1.73% band, 2 runs/arm
ub128-beats-ub256-d100000	^arm\tub128\tmedian d100000=([\d.]+)	>%	^arm\tub256\tmedian d100000=([\d.]+)@@1.73
